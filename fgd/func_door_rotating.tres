},
"message": ""
}
class_property_descriptions = {
"targetname": "Name a button or lever uses to open this. Leave empty for a door that opens when you walk up.",
"distance": "How far it swings, in degrees. Negative swings the other way.",
"axis": ["The line it swings around. Normal doors: Vertical.", 0],
"hinge": ["Where the hinge is. Origin brush = the middle of a brush painted with the origin texture (included in this entity).", 0],
"speed": "How fast it swings, in degrees per second.",
"wait": "Seconds it stays open before closing. -1 = stays open. -2 = automatic: 3 seconds, or stays open if it has a targetname.",
"key": ["Locked until the player is carrying this key.", 0],
"message": "Shown on screen when a player walks up to it while it is locked or waiting for a button/lever."
}
