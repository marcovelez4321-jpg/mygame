[resource]
script = ExtResource("1")
script_class = ExtResource("2")
classname = "func_door"
description = "Sliding door. Opens by itself when a player walks up -- unless it has a targetname, then only a button or lever whose target matches opens it. Set key to lock it until the player has that key."
class_properties = Dictionary[String, Variant]({
"angle": -1,
"key": {
"Gold": 2,
"None": 0,
"Silver": 1
},
"lip": 8.0,
"message": "",
"speed": 100.0,
"targetname": "",
"use": {
"Press F": 1,
"Walk up": 0
},
"wait": -2.0
})
class_property_descriptions = Dictionary[String, Variant]({
"angle": "Direction it slides open: -1 = up, -2 = down, or degrees in the top view (0 = east, 90 = north, 180 = west, 270 = south).",
"key": ["Locked until the player is carrying this key (place an item_key with the same colour).", 0],
"lip": "How much of the door still shows when fully open, in units.",
"message": "Shown on screen when a player walks up to it while it is locked or waiting for a button/lever.",
"speed": "How fast it moves, in units per second.",
"targetname": "Name a button or lever uses to open this (type the same name in its target). Leave empty for a door that opens when you walk up.",
"use": ["Walk up: opens as you come near. Press F: opens only when a player presses F on it, and shuts by itself once they're through.", 0],
"wait": "Seconds it stays open before closing. -1 = stays open (opened by a button/lever: using it again closes it). -2 = automatic: 3 seconds, or stays open if it has a targetname."
})
meta_properties = Dictionary[String, Variant]({
"color": Color(0.9, 0.6, 0.2, 1)
})
node_class = "AnimatableBody3D"
