[resource]
script = ExtResource("1")
script_class = ExtResource("2")
classname = "func_door_rotating"
description = "Swinging door. Swings around its hinge: draw a small brush with the origin texture where the hinge goes, or pick a hinge edge below. Opens like func_door (walk up, or by a button/lever via targetname)."
class_properties = Dictionary[String, Variant]({
"axis": {
"East-west line": 1,
"North-south line": 2,
"Vertical (normal door)": 0
},
"distance": 90.0,
"hinge": {
"Bottom edge": 1,
"East or north end": 4,
"Origin brush (or the middle)": 0,
"Top edge": 2,
"West or south end": 3
},
"key": {
"Gold": 2,
"None": 0,
"Silver": 1
},
"message": "",
"speed": 100.0,
"targetname": "",
"use": {
"Press F": 1,
"Walk up": 0
},
"wait": -2.0
})
class_property_descriptions = Dictionary[String, Variant]({
"axis": ["The line it swings around. Normal doors: Vertical.", 0],
"distance": "How far it swings, in degrees. Negative swings the other way.",
"hinge": ["Where the hinge is. Origin brush = the middle of a brush painted with the origin texture (included in this entity).", 0],
"key": ["Locked until the player is carrying this key.", 0],
"message": "Shown on screen when a player walks up to it while it is locked or waiting for a button/lever.",
"speed": "How fast it swings, in degrees per second.",
"targetname": "Name a button or lever uses to open this. Leave empty for a door that opens when you walk up.",
"use": ["Walk up: opens as you come near. Press F: opens only when a player presses F on it, and shuts by itself once they're through.", 0],
"wait": "Seconds it stays open before closing. -1 = stays open. -2 = automatic: 3 seconds, or stays open if it has a targetname."
})
meta_properties = Dictionary[String, Variant]({
"color": Color(0.9, 0.6, 0.2, 1)
})
node_class = "AnimatableBody3D"
